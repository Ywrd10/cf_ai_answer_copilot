{
  "name": "cf-ai-answer-copilot-v1",
  "main": "api/src/index.ts",
  "compatibility_date": "2026-01-13",

  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      { "name": "MEMORY", "class_name": "MemoryDO" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MemoryDO"] }
  ],

  "vectorize": [
    { "binding": "VECTORIZE", "index_name": "cf-ai-answer-copilot-kb", "remote": true }
  ],

  "analytics_engine_datasets": [
    { "binding": "RAG_ANALYTICS", "dataset": "rag_answer_copilot" }
  ]
}
